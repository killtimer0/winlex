LANGUAGE 9, 1
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open files...\tCtrl+O", LOAD_METADATA
        MENUITEM "Open selected &result\tEnter", OPEN_RESULT
        MENUITEM "Open in &new document\tCtrl+Enter", OPEN_NEW
        MENUITEM "&Close document\tCtrl+F4", CLOSE
        MENUITEM "E&xit", EXIT
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "Tile &side by side", COLUMNS
        MENUITEM "Tile &top and bottom", ROWS
        MENUITEM "&Free arrangement", FREE
        MENUITEM "&Maximize document", MAXIMIZE
    END
    POPUP "&Options"
    BEGIN
        POPUP "&Language"
        BEGIN
            MENUITEM "&System default", LANGUAGE_AUTO
            MENUITEM "&English", LANGUAGE_ENGLISH
            MENUITEM "简体中文(&C)", LANGUAGE_CHINESE
        END
    END
END
STRINGTABLE
BEGIN
    IDS_ARCHITECTURE "Architecture"
    IDS_DETAILS "Details"
    IDS_PREVIEW "Preview"
    IDS_WORKER_STOPPED "Background worker stopped"
    IDS_COPY_DECIMAL "Copy decimal"
    IDS_COPY_HEX "Copy hexadecimal"
    IDS_COPY_VALUE "Copy value with unit"
    IDS_COPY_SELECTION "Copy selected text"
    IDS_LOADED "Loaded"
    IDS_SEARCH_PROGRESS "Searching: {count} results"
    IDS_PANEL_SEARCH "Search"
    IDS_PANEL_SOURCES "Metadata"
    IDS_OLD_VERSION "Earlier catalog snapshot"
    IDS_RELOAD "Reload"
    IDS_UNLOAD "Close source"
    IDS_LANGUAGE_RESTART "Language saved. The change takes effect after restarting Winlex."
    IDS_UNSUPPORTED_ARCH "This declaration does not support x86 or x64."
    IDS_APP_TITLE "Winlex"
    IDS_EMPTY_CATALOG "No metadata loaded. Open files to begin."
    IDS_LOADING "Loading metadata..."
    IDS_LOAD_FAILED "Load failed; previous catalog retained: {error}"
    IDS_ENTER_QUERY "Ready. Type a name to search; Enter searches immediately."
    IDS_SEARCHING "Searching..."
    IDS_SEARCH_STATUS "Results {total}. Click or Space to preview; double-click or Enter to open."
    IDS_QUERYING "Loading declaration..."
    IDS_SOURCE "Source"
    IDS_WINMD_FILES "Windows metadata (*.winmd)"
    IDS_ALL_FILES "All files (*.*)"
    IDS_LOAD_METADATA "Open files"
