LANGUAGE 9, 1
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open files...\tCtrl+O", LOAD_METADATA
        MENUITEM SEPARATOR
        MENUITEM "&Settings...", SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", EXIT
    END
    POPUP "&Navigate"
    BEGIN
        MENUITEM "&Back\tAlt+Left", HISTORY_BACK, GRAYED
        MENUITEM "&Forward\tAlt+Right", HISTORY_FORWARD, GRAYED
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Close document\tCtrl+F4", CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Tile &side by side", COLUMNS
        MENUITEM "Tile &top and bottom", ROWS
        MENUITEM "&Free arrangement", FREE
        MENUITEM "&Maximize document", MAXIMIZE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Search &syntax...", SEARCH_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About", ABOUT
    END
END
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Interface &language:", -1, 10, 12, 90, 10
    COMBOBOX SETTINGS_LANGUAGE, 104, 9, 126, 70, 0x50210003
    LTEXT "Language changes take effect after restarting Winlex.", -1, 10, 35, 220, 26
END
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Show these entries in search results:", -1, 10, 10, 220, 12
    CONTROL "&Types", FILTER_TYPE, "Button", 0x50010003, 10, 30, 220, 12
    CONTROL "Functions/&Methods", FILTER_METHOD, "Button", 0x50010003, 10, 46, 220, 12
    CONTROL "&Constants", FILTER_CONSTANT, "Button", 0x50010003, 10, 62, 220, 12
    CONTROL "&Fields", FILTER_FIELD, "Button", 0x50010003, 10, 78, 220, 12
    CONTROL "&Properties", FILTER_PROPERTY, "Button", 0x50010003, 10, 94, 220, 12
    CONTROL "&Events", FILTER_EVENT, "Button", 0x50010003, 10, 110, 220, 12
    CONTROL "Type &references", FILTER_REFERENCE, "Button", 0x50010003, 10, 126, 220, 12
END
