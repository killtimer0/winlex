    IDS_SETTINGS "Settings"
    IDS_MODE_COMBINED "Quick"
    IDS_MODE_CONDITION "Conditions"
    IDS_INCOMPLETE_CONDITION_QUERY "Incomplete condition"
    IDS_QUERY_FIELD "Invalid condition: unknown field"
