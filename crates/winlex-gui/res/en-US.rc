STRINGTABLE
BEGIN
    IDS_FIND "Find:"
    IDS_FIND_NEXT "Next"
    IDS_FIND_PREVIOUS "Previous"
    IDS_FIND_CLOSE "Close"
    IDS_FIND_CASE "Match case"
    IDS_FIND_WORD "Whole word"
    IDS_FIND_WRAPPED "Wrapped"
END
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open files...\tCtrl+O", LOAD_METADATA
        MENUITEM SEPARATOR
        MENUITEM "&Settings...", SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", EXIT
    END
    POPUP "&Navigate"
    BEGIN
        MENUITEM "&Find in document...\tCtrl+F", FIND_DOCUMENT
        MENUITEM "Find &next\tF3", FIND_NEXT
        MENUITEM "Find &previous\tShift+F3", FIND_PREVIOUS
        MENUITEM SEPARATOR
        MENUITEM "&Back\tAlt+Left", HISTORY_BACK, GRAYED
        MENUITEM "&Forward\tAlt+Right", HISTORY_FORWARD, GRAYED
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Always on Top", ALWAYS_ON_TOP
        MENUITEM SEPARATOR
        MENUITEM "Tile &side by side", COLUMNS
        MENUITEM "Tile &top and bottom", ROWS
        MENUITEM "&Free arrangement", FREE
        MENUITEM "&Maximize document", MAXIMIZE
        MENUITEM "&Close document\tCtrl+F4", CLOSE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Search &syntax...", SEARCH_HELP
        MENUITEM "Get &metadata…", GET_METADATA
        MENUITEM SEPARATOR
        MENUITEM "&About Winlex...", ABOUT
    END
END
IDD_ABOUT DIALOGEX 0, 0, 250, 142
STYLE 0x80C800C0
CAPTION "About Winlex"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_APP, ABOUT_ICON, 12, 12, 20, 20
    CONTROL VERSION_TEXT, ABOUT_INFO, "SysLink", 0x50010000, 48, 12, 190, 96
    DEFPUSHBUTTON "OK", 1, 188, 116, 50, 14
END
IDD_SEARCH_HELP DIALOGEX 0, 0, 350, 250
STYLE 0x80CC00C0
CAPTION "Search syntax"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT SEARCH_HELP_TEXT, 7, 7, 336, 215, 0x50210844
    DEFPUSHBUTTON "Close", 1, 293, 229, 50, 14
END
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Interface &language:", -1, 10, 12, 90, 10
    COMBOBOX SETTINGS_LANGUAGE, 104, 9, 126, 70, 0x50210003
    LTEXT "Language changes take effect after restarting Winlex.", -1, 10, 35, 220, 26
    LTEXT "&Appearance:", -1, 10, 70, 90, 10
    COMBOBOX SETTINGS_THEME, 104, 67, 126, 70, 0x50210003
END
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Show these entries in search results:", -1, 10, 10, 220, 12
    CONTROL "&Types", FILTER_TYPE, "Button", 0x50010003, 10, 30, 220, 12
    CONTROL "Functions/&Methods", FILTER_METHOD, "Button", 0x50010003, 10, 46, 220, 12
    CONTROL "&Constants", FILTER_CONSTANT, "Button", 0x50010003, 10, 62, 220, 12
    CONTROL "&Fields", FILTER_FIELD, "Button", 0x50010003, 10, 78, 220, 12
    CONTROL "&Properties", FILTER_PROPERTY, "Button", 0x50010003, 10, 94, 220, 12
    CONTROL "&Events", FILTER_EVENT, "Button", 0x50010003, 10, 110, 220, 12
    CONTROL "Type &references", FILTER_REFERENCE, "Button", 0x50010003, 10, 126, 220, 12
END
