LANGUAGE 9, 1
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Close document\tCtrl+F4", CLOSE
        MENUITEM "E&xit", EXIT
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "Tile &side by side", COLUMNS
        MENUITEM "Tile &top and bottom", ROWS
        MENUITEM "&Free arrangement", FREE
        MENUITEM "&Maximize document", MAXIMIZE
    END
    POPUP "&Options"
    BEGIN
        POPUP "&Language"
        BEGIN
            MENUITEM "&System default", LANGUAGE_AUTO
            MENUITEM "&English", LANGUAGE_ENGLISH
            MENUITEM "简体中文(&C)", LANGUAGE_CHINESE
        END
    END
END
