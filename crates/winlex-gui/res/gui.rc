#pragma code_page(65001)
#include "resource.h"
#include "version.h"

LANGUAGE 0, 0
IDR_ACCELERATORS ACCELERATORS
BEGIN
    "L", FOCUS_SEARCH, VIRTKEY, CONTROL
    0x0D, OPEN_NEW, VIRTKEY, CONTROL
    0x75, FOCUS_NEXT_REGION, VIRTKEY
END
1 24 "gui.manifest"
1 VERSIONINFO
 FILEVERSION VERSION_NUMBER
 PRODUCTVERSION VERSION_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Winlex GUI"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "winlex-gui"
            VALUE "OriginalFilename", "winlex-gui.exe"
            VALUE "ProductName", "Winlex"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "en-US.rc"
#include "zh-CN.rc"
