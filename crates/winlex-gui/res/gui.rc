#pragma code_page(65001)
#include "resource.h"
#include "version.h"

LANGUAGE 0, 0
IDI_APP ICON "appicon.ico"
IDR_SYMBOL_CLASS 10 "codicons/symbol-class.emf"
IDR_SYMBOL_INTERFACE 10 "codicons/symbol-interface.emf"
IDR_SYMBOL_STRUCT 10 "codicons/symbol-structure.emf"
IDR_SYMBOL_ENUM 10 "codicons/symbol-enum.emf"
IDR_SYMBOL_METHOD 10 "codicons/symbol-method.emf"
IDR_SYMBOL_CONSTANT 10 "codicons/symbol-constant.emf"
IDR_SYMBOL_FIELD 10 "codicons/symbol-field.emf"
IDR_SYMBOL_PROPERTY 10 "codicons/symbol-property.emf"
IDR_SYMBOL_EVENT 10 "codicons/symbol-event.emf"
IDR_SYMBOL_REFERENCE 10 "codicons/references.emf"
IDR_SYMBOL_MISC 10 "codicons/symbol-misc.emf"
IDR_FILE 10 "codicons/file.emf"
IDR_SEARCH 10 "codicons/search.emf"
IDR_FILES 10 "codicons/files.emf"
IDR_ACCELERATORS ACCELERATORS
BEGIN
    "O", LOAD_METADATA, VIRTKEY, CONTROL
    "L", FOCUS_SEARCH, VIRTKEY, CONTROL
    "F", FIND_DOCUMENT, VIRTKEY, CONTROL
    0x72, FIND_NEXT, VIRTKEY
    0x72, FIND_PREVIOUS, VIRTKEY, SHIFT
    0x0D, OPEN_NEW, VIRTKEY, CONTROL
    0x75, FOCUS_NEXT_REGION, VIRTKEY
    0x25, HISTORY_BACK, VIRTKEY, ALT
    0x27, HISTORY_FORWARD, VIRTKEY, ALT
END
1 24 "gui.manifest"
1 VERSIONINFO
 FILEVERSION VERSION_NUMBER
 PRODUCTVERSION VERSION_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Winlex GUI"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "winlex-gui"
            VALUE "OriginalFilename", "winlex-gui.exe"
            VALUE "ProductName", "Winlex"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "en-US.rc"
#include "zh-CN.rc"
