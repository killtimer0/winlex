IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开文件(&O)...\tCtrl+O", LOAD_METADATA
        MENUITEM SEPARATOR
        MENUITEM "设置(&S)...", SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "退出(&E)", EXIT
    END
    POPUP "导航(&N)"
    BEGIN
        MENUITEM "正文查找(&S)...\tCtrl+F", FIND_DOCUMENT
        MENUITEM "查找下一处(&N)\tF3", FIND_NEXT
        MENUITEM "查找上一处(&P)\tShift+F3", FIND_PREVIOUS
        MENUITEM SEPARATOR
        MENUITEM "返回(&B)\tAlt+Left", HISTORY_BACK, GRAYED
        MENUITEM "前进(&F)\tAlt+Right", HISTORY_FORWARD, GRAYED
    END
    POPUP "窗口(&W)"
    BEGIN
        MENUITEM "置于顶层(&A)", ALWAYS_ON_TOP
        MENUITEM SEPARATOR
        MENUITEM "左右平铺(&S)", COLUMNS
        MENUITEM "上下平铺(&T)", ROWS
        MENUITEM "自由排列(&F)", FREE
        MENUITEM "最大化文档(&M)", MAXIMIZE
        MENUITEM "关闭文档(&C)\tCtrl+F4", CLOSE
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "搜索语法(&S)...", SEARCH_HELP
        MENUITEM "获取元数据(&M)…", GET_METADATA
        MENUITEM SEPARATOR
        MENUITEM "关于 Winlex(&A)...", ABOUT
    END
END
IDD_ABOUT DIALOGEX 0, 0, 250, 142
STYLE 0x80C800C0
CAPTION "关于 Winlex"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_APP, ABOUT_ICON, 12, 12, 20, 20
    CONTROL VERSION_TEXT, ABOUT_INFO, "SysLink", 0x50010000, 48, 12, 190, 96
    DEFPUSHBUTTON "确定", 1, 188, 116, 50, 14
END
IDD_GENERIC_BIND DIALOGEX 0, 0, 350, 136
STYLE 0x80CC00C0
CAPTION "绑定类型实参"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "每项输入一个类型，例如 string、int32 或 0::Namespace.Type<int32>。", GENERIC_HINT, 10, 10, 330, 24
    CONTROL "", GENERIC_FORM, "Static", 0x40000000, 10, 40, 314, 34
    CONTROL "", GENERIC_ROW, "Static", 0x40000000, 10, 40, 314, 34
    LTEXT "", GENERIC_LABEL_TEMPLATE, 10, 40, 314, 12, 0x00004000
    EDITTEXT GENERIC_FIELD_TEMPLATE, 10, 54, 314, 14, 0x50010080
    SCROLLBAR GENERIC_SCROLL, 328, 40, 12, 34, 0x50000001
    LTEXT "", GENERIC_ERROR, 10, 80, 330, 26
    DEFPUSHBUTTON "打开实例", GENERIC_APPLY, 218, 112, 70, 14
    PUSHBUTTON "取消", 2, 294, 112, 46, 14
END
IDD_SEARCH_HELP DIALOGEX 0, 0, 350, 250
STYLE 0x80CC00C0
CAPTION "搜索语法"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT SEARCH_HELP_TEXT, 7, 7, 336, 215, 0x50210844
    DEFPUSHBUTTON "关闭", 1, 293, 229, 50, 14
END
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "界面语言(&L)：", -1, 10, 12, 90, 10
    COMBOBOX SETTINGS_LANGUAGE, 104, 9, 126, 70, 0x50210003
    LTEXT "更改语言将在重新启动 Winlex 后生效。", -1, 10, 35, 220, 26
    LTEXT "外观(&A)：", -1, 10, 70, 90, 10
    COMBOBOX SETTINGS_THEME, 104, 67, 126, 70, 0x50210003
END
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "选择搜索结果中显示的条目：", -1, 10, 10, 220, 12
    CONTROL "类型(&T)", FILTER_TYPE, "Button", 0x50010003, 10, 30, 106, 12
    CONTROL "函数(&F)", FILTER_FUNCTION, "Button", 0x50010003, 10, 46, 106, 12
    CONTROL "方法(&M)", FILTER_METHOD, "Button", 0x50010003, 10, 62, 106, 12
    CONTROL "常量(&C)", FILTER_CONSTANT, "Button", 0x50010003, 10, 78, 106, 12
    CONTROL "字段(&D)", FILTER_FIELD, "Button", 0x50010003, 124, 30, 106, 12
    CONTROL "属性(&P)", FILTER_PROPERTY, "Button", 0x50010003, 124, 46, 106, 12
    CONTROL "事件(&E)", FILTER_EVENT, "Button", 0x50010003, 124, 62, 106, 12
    CONTROL "类型引用(&R)", FILTER_REFERENCE, "Button", 0x50010003, 124, 78, 106, 12
    LTEXT "在线搜索引擎(&S)：", -1, 10, 105, 90, 10
    COMBOBOX SETTINGS_SEARCH_ENGINE, 104, 102, 126, 70, 0x50210003
END
STRINGTABLE
BEGIN
    IDS_SETTINGS "设置"
    IDS_MODE_COMBINED "快速"
    IDS_MODE_CONDITION "条件"
    IDS_INCOMPLETE_CONDITION_QUERY "条件尚未输入完整"
    IDS_QUERY_FIELD "条件无效：未知字段"
    IDS_QUERY_OPERATOR "条件无效：此字段不支持该操作"
    IDS_QUERY_VALUE "条件无效：请检查值的类型、范围或格式"
    IDS_QUERY_LIMIT "查询超过支持的长度或复杂度"
    IDS_SEARCH_HELP "快速搜索匹配名称、常量值和 GUID。\n\n条件示例：\nname contains ""access"" and value = 5\nvalue contains ""Windows""\nvalue >= 1.45 and value < 1.55\nvalue = nan or value = inf\n\n使用 AND、OR、NOT 和括号；字符串需加双引号。\n字段：name、fullname、value、guid、namespace、category、source、architecture。\n文本操作：=、contains、starts_with；名称还支持 fuzzy。\nnamespace within ""Windows.Win32"" 包含子命名空间。\nsource = 0 指第一个输入；architecture = ""x86"" 指适用于 x86。\n\n整数、浮点数和字符串不同：5、5.0、""5""。\n浮点边界按常量声明类型舍入。\nnan 匹配所有 NaN；inf 和 -inf 匹配相应符号的无穷。\nNaN 不能作为有序边界；NOT 也包含缺少该字段的条目。"
    IDS_INVALID_CONDITION_QUERY "条件无效：语法错误"
