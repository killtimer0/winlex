LANGUAGE 4, 2
IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开文件(&O)...\tCtrl+O", LOAD_METADATA
        MENUITEM "打开选定结果(&R)\tEnter", OPEN_RESULT
        MENUITEM "在新文档中打开(&N)\tCtrl+Enter", OPEN_NEW
        MENUITEM "关闭文档(&C)\tCtrl+F4", CLOSE
        MENUITEM "退出(&E)", EXIT
    END
    POPUP "窗口(&W)"
    BEGIN
        MENUITEM "左右平铺(&S)", COLUMNS
        MENUITEM "上下平铺(&T)", ROWS
        MENUITEM "自由排列(&F)", FREE
        MENUITEM "最大化文档(&M)", MAXIMIZE
    END
    POPUP "设置(&O)"
    BEGIN
        POPUP "语言(&L)"
        BEGIN
            MENUITEM "跟随系统(&S)", LANGUAGE_AUTO
            MENUITEM "English(&E)", LANGUAGE_ENGLISH
            MENUITEM "简体中文(&C)", LANGUAGE_CHINESE
        END
    END
END
STRINGTABLE
BEGIN
    IDS_ARCHITECTURE "架构"
    IDS_PREVIEW "预览"
    IDS_WORKER_STOPPED "后台工作线程已停止"
    IDS_COPY_DECIMAL "复制十进制"
    IDS_COPY_HEX "复制十六进制"
    IDS_COPY_VALUE "复制带单位的值"
    IDS_COPY_SELECTION "复制选中文本"
    IDS_LOADED "已加载"
    IDS_SEARCH_PROGRESS "搜索中：{count} 个结果"
    IDS_PANEL_SEARCH "搜索"
    IDS_PANEL_SOURCES "元数据"
    IDS_OLD_VERSION "先前的目录快照"
    IDS_RELOAD "重新加载"
    IDS_UNLOAD "关闭来源"
    IDS_LANGUAGE_RESTART "语言已保存，重新启动 Winlex 后生效。"
    IDS_UNSUPPORTED_ARCH "此声明不支持 x86 或 x64。"
    IDS_APP_TITLE "Winlex"
    IDS_EMPTY_CATALOG "尚未加载元数据。打开文件即可开始。"
    IDS_LOADING "正在加载元数据…"
    IDS_LOAD_FAILED "加载失败，已保留原目录：{error}"
    IDS_ENTER_QUERY "已就绪。输入名称自动搜索，回车立即执行。"
    IDS_SEARCHING "正在搜索…"
    IDS_SEARCH_STATUS "共 {total} 条。单击或空格预览，双击或回车打开。"
    IDS_QUERYING "正在加载声明…"
    IDS_WINMD_FILES "Windows 元数据 (*.winmd)"
    IDS_ALL_FILES "所有文件 (*.*)"
    IDS_LOAD_METADATA "打开文件"
END
