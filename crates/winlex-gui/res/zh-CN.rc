LANGUAGE 4, 2
IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开文件(&O)...\tCtrl+O", LOAD_METADATA
        MENUITEM SEPARATOR
        MENUITEM "设置(&S)...", SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "退出(&E)", EXIT
    END
    POPUP "窗口(&W)"
    BEGIN
        MENUITEM "关闭文档(&C)\tCtrl+F4", CLOSE
        MENUITEM SEPARATOR
        MENUITEM "左右平铺(&S)", COLUMNS
        MENUITEM "上下平铺(&T)", ROWS
        MENUITEM "自由排列(&F)", FREE
        MENUITEM "最大化文档(&M)", MAXIMIZE
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "搜索语法(&S)...", SEARCH_HELP
        MENUITEM SEPARATOR
        MENUITEM "关于(&A)", ABOUT
    END
END
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "界面语言(&L)：", -1, 10, 12, 90, 10
    COMBOBOX SETTINGS_LANGUAGE, 104, 9, 126, 70, 0x50210003
    LTEXT "更改语言将在重新启动 Winlex 后生效。", -1, 10, 35, 220, 26
END
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 240, 150
STYLE 0x40000448
EXSTYLE 0x00010000
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "选择搜索结果中显示的条目：", -1, 10, 10, 220, 12
    CONTROL "类型(&T)", FILTER_TYPE, "Button", 0x50010003, 10, 30, 220, 12
    CONTROL "函数/方法(&M)", FILTER_METHOD, "Button", 0x50010003, 10, 46, 220, 12
    CONTROL "常量(&C)", FILTER_CONSTANT, "Button", 0x50010003, 10, 62, 220, 12
    CONTROL "字段(&F)", FILTER_FIELD, "Button", 0x50010003, 10, 78, 220, 12
    CONTROL "属性(&P)", FILTER_PROPERTY, "Button", 0x50010003, 10, 94, 220, 12
    CONTROL "事件(&E)", FILTER_EVENT, "Button", 0x50010003, 10, 110, 220, 12
    CONTROL "类型引用(&R)", FILTER_REFERENCE, "Button", 0x50010003, 10, 126, 220, 12
END
STRINGTABLE
BEGIN
    IDS_SETTINGS "设置"
    IDS_MODE_COMBINED "快速搜索"
    IDS_MODE_CONDITION "条件搜索"
    IDS_INCOMPLETE_CONDITION_QUERY "条件尚未输入完整"
    IDS_QUERY_FIELD "条件无效：未知字段"
    IDS_QUERY_OPERATOR "条件无效：此字段不支持该操作"
    IDS_QUERY_VALUE "条件无效：请检查值的类型、范围或格式"
    IDS_QUERY_LIMIT "查询超过支持的长度或复杂度"
    IDS_SEARCH_HELP_TITLE "搜索语法"
    IDS_SEARCH_HELP "快速搜索匹配名称、常量值和 GUID。\n\n条件示例：\nname contains ""access"" and value = 5\nvalue contains ""Windows""\nvalue >= 1.45 and value < 1.55\nvalue = nan or value = inf\n\n使用 AND、OR、NOT 和括号；字符串需加双引号。\n字段：name、fullname、value、guid、namespace、category、source、architecture。\n文本操作：=、contains、starts_with；名称还支持 fuzzy。\nnamespace within ""Windows.Win32"" 包含子命名空间。\nsource = 0 指第一个输入；architecture = ""x86"" 指适用于 x86。\n\n整数、浮点数和字符串不同：5、5.0、""5""。\n浮点边界按常量声明类型舍入。\nnan 匹配所有 NaN；inf 和 -inf 匹配相应符号的无穷。\nNaN 不能作为有序边界；NOT 也包含缺少该字段的条目。"
    IDS_INVALID_CONDITION_QUERY "条件无效：语法错误"
    IDS_SEARCH_TIP_QUICK "搜索名称、常量值和 GUID。\n示例：CrtFlW、5、1.5、Windows\n组合多个条件时，请选择“条件搜索”。\n完整说明：帮助 → 搜索语法。"
    IDS_SEARCH_TIP_CONDITION "按字段组合搜索，支持 AND、OR、NOT 和括号。\nname contains ""access"" and value = 5\nvalue >= 1.45 and value < 1.55\n完整说明：帮助 → 搜索语法。"
